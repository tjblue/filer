#!/usr/bin/env python3
"""
Filer - A simple directory-based file server with a modern web UI.
"""

import os
import re
import json
import shutil
import argparse
import subprocess
import uuid
import threading
import time
import socket
from pathlib import Path
from datetime import datetime, timedelta
from flask import Flask, render_template, request, jsonify, send_file, abort, render_template_string
from fnmatch import fnmatch
from werkzeug.utils import secure_filename

app = Flask(__name__)
ROOT_DIR = None

# ============ QUICK TRANSFER CONFIGURATION ============
QT_UPLOAD_FOLDER = 'data/uploads'
QT_METADATA_FILE = 'data/metadata.json'
DEFAULT_EXPIRY_HOURS = 2
MAX_EXPIRY_DAYS = 7
MAX_FILE_SIZE_MB = 100
qt_metadata_lock = threading.Lock()


def safe_path(requested_path: str) -> Path:
    """Validate and return a safe path within ROOT_DIR."""
    if not requested_path:
        return ROOT_DIR

    # Normalize and resolve the path
    clean_path = requested_path.replace('\\', '/').strip('/')

    # Reject any path traversal attempts
    if '..' in clean_path.split('/'):
        abort(403, 'Path traversal not allowed')

    full_path = (ROOT_DIR / clean_path).resolve()

    # Ensure the path is within ROOT_DIR
    try:
        full_path.relative_to(ROOT_DIR)
    except ValueError:
        abort(403, 'Access denied')

    return full_path


def get_file_info(path: Path, relative_to: Path) -> dict:
    """Get file/folder information."""
    stat = path.stat()
    return {
        'name': path.name,
        'path': str(path.relative_to(relative_to)).replace('\\', '/'),
        'isDirectory': path.is_dir(),
        'size': stat.st_size if path.is_file() else None,
        'modified': datetime.fromtimestamp(stat.st_mtime).isoformat(),
    }


# ============ QUICK TRANSFER HELPER FUNCTIONS ============

def qt_ensure_directories():
    """Create required directories for Quick Transfer"""
    os.makedirs(QT_UPLOAD_FOLDER, exist_ok=True)
    os.makedirs(os.path.dirname(QT_METADATA_FILE), exist_ok=True)

def qt_load_metadata():
    """Load Quick Transfer metadata from JSON file"""
    with qt_metadata_lock:
        if os.path.exists(QT_METADATA_FILE):
            try:
                with open(QT_METADATA_FILE, 'r', encoding='utf-8') as f:
                    return json.load(f)
            except (json.JSONDecodeError, IOError):
                return {"items": {}}
        return {"items": {}}

def qt_save_metadata(data):
    """Save Quick Transfer metadata to JSON file"""
    with qt_metadata_lock:
        with open(QT_METADATA_FILE, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2)

def qt_generate_id():
    """Generate a short unique ID"""
    return uuid.uuid4().hex[:8]

def qt_format_size(bytes_count):
    """Format file size for display"""
    if bytes_count < 1024:
        return f"{bytes_count} B"
    if bytes_count < 1024 * 1024:
        return f"{bytes_count / 1024:.1f} KB"
    if bytes_count < 1024 * 1024 * 1024:
        return f"{bytes_count / (1024 * 1024):.1f} MB"
    return f"{bytes_count / (1024 * 1024 * 1024):.1f} GB"

def qt_format_time_remaining(expires_at_str):
    """Format time remaining until expiration"""
    expires_at = datetime.fromisoformat(expires_at_str)
    now = datetime.now()
    diff = expires_at - now

    if diff.total_seconds() <= 0:
        return "Expired"

    hours = int(diff.total_seconds() // 3600)
    minutes = int((diff.total_seconds() % 3600) // 60)

    if hours >= 24:
        days = hours // 24
        remaining_hours = hours % 24
        return f"{days}d {remaining_hours}h"
    if hours > 0:
        return f"{hours}h {minutes}m"
    return f"{minutes}m"

def qt_is_expired(item):
    """Check if an item has expired"""
    expires_at = datetime.fromisoformat(item['expires_at'])
    return datetime.now() > expires_at

def qt_get_item(item_id):
    """Get item by ID, returning None if not found or expired"""
    metadata = qt_load_metadata()
    item = metadata['items'].get(item_id)

    if item and qt_is_expired(item):
        qt_delete_item(item_id)
        return None

    return item

def qt_delete_item(item_id):
    """Remove item from storage"""
    metadata = qt_load_metadata()
    item = metadata['items'].get(item_id)

    if item:
        if item['type'] == 'file':
            file_path = os.path.join(QT_UPLOAD_FOLDER, item['stored_name'])
            if os.path.exists(file_path):
                try:
                    os.remove(file_path)
                except OSError:
                    pass

        del metadata['items'][item_id]
        qt_save_metadata(metadata)
        return True
    return False

def qt_cleanup_expired():
    """Background thread to clean up expired items"""
    while True:
        time.sleep(300)  # Check every 5 minutes

        try:
            metadata = qt_load_metadata()
            expired_ids = []

            for item_id, item in metadata['items'].items():
                if qt_is_expired(item):
                    expired_ids.append(item_id)
                    if item['type'] == 'file':
                        file_path = os.path.join(QT_UPLOAD_FOLDER, item['stored_name'])
                        if os.path.exists(file_path):
                            try:
                                os.remove(file_path)
                            except OSError:
                                pass

            if expired_ids:
                for item_id in expired_ids:
                    del metadata['items'][item_id]
                qt_save_metadata(metadata)
                print(f"[Quick Transfer Cleanup] Removed {len(expired_ids)} expired items")
        except Exception as e:
            print(f"[Quick Transfer Cleanup Error] {e}")

def qt_get_local_ip():
    """Get the local network IP address"""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(('8.8.8.8', 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return '127.0.0.1'


# ============ QUICK TRANSFER ROUTES ============

@app.route('/qt/')
def quicktransfer():
    """Quick Transfer UI"""
    network_ip = f"http://{qt_get_local_ip()}:{app.config.get('PORT', 5000)}"
    return render_template('quicktransfer.html', network_ip=network_ip)

@app.route('/qt/upload', methods=['POST'])
def qt_upload_file():
    """Handle file upload"""
    if 'file' not in request.files:
        return jsonify({'error': 'No file provided'}), 400

    file = request.files['file']
    if file.filename == '':
        return jsonify({'error': 'No file selected'}), 400

    # Get expiry time
    expiry_hours = request.form.get('expiry_hours', DEFAULT_EXPIRY_HOURS, type=int)
    expiry_hours = min(expiry_hours, MAX_EXPIRY_DAYS * 24)

    # Generate ID and filename
    item_id = qt_generate_id()
    original_name = secure_filename(file.filename) or 'unnamed'
    stored_name = f"{item_id}_{original_name}"
    file_path = os.path.join(QT_UPLOAD_FOLDER, stored_name)

    # Save file
    file.save(file_path)
    file_size = os.path.getsize(file_path)

    # Save metadata
    now = datetime.now()
    expires_at = now + timedelta(hours=expiry_hours)

    metadata = qt_load_metadata()
    metadata['items'][item_id] = {
        'id': item_id,
        'type': 'file',
        'original_name': original_name,
        'stored_name': stored_name,
        'size_bytes': file_size,
        'created_at': now.isoformat(),
        'expires_at': expires_at.isoformat()
    }
    qt_save_metadata(metadata)

    return jsonify({
        'success': True,
        'id': item_id,
        'download_url': f'/qt/download/{item_id}',
        'expires_at': expires_at.isoformat()
    })

@app.route('/qt/text', methods=['POST'])
def qt_upload_text():
    """Handle text snippet upload"""
    data = request.get_json()
    if not data or not data.get('content'):
        return jsonify({'error': 'No content provided'}), 400

    content = data['content']
    title = data.get('title', '').strip() or 'Untitled'
    expiry_hours = data.get('expiry_hours', DEFAULT_EXPIRY_HOURS)
    expiry_hours = min(int(expiry_hours), MAX_EXPIRY_DAYS * 24)

    item_id = qt_generate_id()
    now = datetime.now()
    expires_at = now + timedelta(hours=expiry_hours)

    metadata = qt_load_metadata()
    metadata['items'][item_id] = {
        'id': item_id,
        'type': 'text',
        'title': title,
        'content': content,
        'size_bytes': len(content.encode('utf-8')),
        'created_at': now.isoformat(),
        'expires_at': expires_at.isoformat()
    }
    qt_save_metadata(metadata)

    return jsonify({
        'success': True,
        'id': item_id,
        'view_url': f'/qt/view/{item_id}',
        'raw_url': f'/qt/raw/{item_id}',
        'expires_at': expires_at.isoformat()
    })

@app.route('/qt/download/<item_id>')
def qt_download(item_id):
    """Download a file"""
    item = qt_get_item(item_id)
    if not item or item['type'] != 'file':
        return "Not found", 404

    file_path = os.path.join(QT_UPLOAD_FOLDER, item['stored_name'])
    if not os.path.exists(file_path):
        return "File not found", 404

    return send_file(
        file_path,
        as_attachment=True,
        download_name=item['original_name']
    )

@app.route('/qt/view/<item_id>')
def qt_view_text(item_id):
    """View a text snippet"""
    item = qt_get_item(item_id)
    if not item or item['type'] != 'text':
        return "Not found", 404

    # View template with Filer styling
    view_html = f"""
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{item['title']} - Quick Transfer</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <script src="https://unpkg.com/lucide@latest"></script>
    </head>
    <body class="bg-gray-900 min-h-screen p-4">
        <div class="max-w-4xl mx-auto">
            <div class="bg-gray-800 rounded-lg shadow-sm border border-gray-700 overflow-hidden">
                <div class="p-4 border-b border-gray-700 flex items-center justify-between flex-wrap gap-3" style="background-color: rgb(42 48 60);">
                    <div class="flex-1 min-w-0">
                        <h1 class="text-lg font-medium text-gray-100 truncate">{item['title']}</h1>
                        <div class="text-xs text-gray-400 mt-1 flex items-center gap-3 flex-wrap">
                            <span>{qt_format_size(item['size_bytes'])}</span>
                            <span class="flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                expires in {qt_format_time_remaining(item['expires_at'])}
                            </span>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="copyContent()" class="px-3 py-1.5 bg-blue-600 text-white text-sm rounded hover:bg-blue-700 flex items-center gap-1">
                            <i data-lucide="copy" class="w-4 h-4"></i> Copy
                        </button>
                        <a href="/qt/raw/{item_id}" class="px-3 py-1.5 bg-gray-700 text-gray-200 text-sm rounded hover:bg-gray-600 flex items-center gap-1">
                            <i data-lucide="file-text" class="w-4 h-4"></i> Raw
                        </a>
                        <a href="/qt/" class="px-3 py-1.5 bg-gray-700 text-gray-200 text-sm rounded hover:bg-gray-600 flex items-center gap-1">
                            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
                        </a>
                    </div>
                </div>
                <pre id="content" class="p-6 text-sm text-gray-200 bg-gray-900 overflow-x-auto whitespace-pre-wrap break-words font-mono leading-relaxed">{item['content']}</pre>
            </div>
        </div>
        <div id="toast" class="fixed bottom-4 right-4 px-4 py-2 rounded-lg shadow-lg text-white transform translate-y-20 transition-transform duration-300 bg-green-500"></div>
        <script>
            lucide.createIcons();

            function copyContent() {{
                const content = document.getElementById('content').textContent;
                navigator.clipboard.writeText(content).then(() => {{
                    const toast = document.getElementById('toast');
                    toast.textContent = 'Copied to clipboard!';
                    toast.style.transform = 'translateY(0)';
                    setTimeout(() => {{
                        toast.style.transform = 'translateY(100px)';
                    }}, 2000);
                }});
            }}
        </script>
    </body>
    </html>
    """
    return render_template_string(view_html)

@app.route('/qt/raw/<item_id>')
def qt_raw_text(item_id):
    """Get raw text content"""
    item = qt_get_item(item_id)
    if not item or item['type'] != 'text':
        return "Not found", 404

    return item['content'], 200, {'Content-Type': 'text/plain; charset=utf-8'}

@app.route('/qt/delete/<item_id>', methods=['DELETE', 'POST'])
def qt_delete(item_id):
    """Delete an item"""
    if qt_delete_item(item_id):
        return jsonify({'success': True})
    return jsonify({'error': 'Not found'}), 404

@app.route('/qt/api/items')
def qt_list_items():
    """List all items"""
    metadata = qt_load_metadata()
    items = []

    for item_id, item in metadata['items'].items():
        if qt_is_expired(item):
            continue

        items.append({
            'id': item['id'],
            'type': item['type'],
            'name': item.get('original_name') or item.get('title', 'Untitled'),
            'size_bytes': item['size_bytes'],
            'created_at': item['created_at'],
            'expires_at': item['expires_at']
        })

    # Sort by creation time, newest first
    items.sort(key=lambda x: x['created_at'], reverse=True)

    return jsonify({'items': items})


# ============ FILER ROUTES ============

@app.route('/')
@app.route('/<path:filepath>')
def index(filepath=''):
    """Serve the main UI for any path."""
    return render_template('index.html')


@app.route('/api/files')
def list_files():
    """List directory contents."""
    path = safe_path(request.args.get('path', ''))

    if not path.exists():
        abort(404, 'Directory not found')

    if not path.is_dir():
        abort(400, 'Not a directory')

    items = []
    try:
        for item in sorted(path.iterdir(), key=lambda x: (not x.is_dir(), x.name.lower())):
            try:
                items.append(get_file_info(item, ROOT_DIR))
            except (PermissionError, OSError):
                continue
    except PermissionError:
        abort(403, 'Permission denied')

    current_path = str(path.relative_to(ROOT_DIR)).replace('\\', '/')
    if current_path == '.':
        current_path = ''

    return jsonify({
        'path': current_path,
        'items': items
    })


@app.route('/api/file', methods=['GET'])
def get_file():
    """Get file content for editing."""
    path = safe_path(request.args.get('path', ''))

    if not path.exists():
        abort(404, 'File not found')

    if path.is_dir():
        abort(400, 'Cannot read directory')

    rel_path = str(path.relative_to(ROOT_DIR)).replace('\\', '/')
    file_info = get_file_info(path, ROOT_DIR)

    try:
        content = path.read_text(encoding='utf-8')
        return jsonify({
            'content': content,
            'path': rel_path,
            'name': path.name,
            'size': file_info['size'],
            'modified': file_info['modified'],
            'isBinary': False
        })
    except UnicodeDecodeError:
        return jsonify({
            'content': None,
            'path': rel_path,
            'name': path.name,
            'size': file_info['size'],
            'modified': file_info['modified'],
            'isBinary': True
        })
    except PermissionError:
        abort(403, 'Permission denied')


@app.route('/api/file', methods=['POST'])
def create_file():
    """Create a new file or folder."""
    data = request.get_json()
    parent = safe_path(data.get('parent', ''))
    name = data.get('name', '').strip()
    is_folder = data.get('isFolder', False)

    if not name or '/' in name or '\\' in name or '..' in name:
        abort(400, 'Invalid name')

    new_path = parent / name

    if new_path.exists():
        abort(409, 'Already exists')

    try:
        if is_folder:
            new_path.mkdir(parents=True)
        else:
            new_path.touch()
        return jsonify({'success': True, 'path': str(new_path.relative_to(ROOT_DIR)).replace('\\', '/')})
    except PermissionError:
        abort(403, 'Permission denied')


@app.route('/api/file', methods=['PUT'])
def update_file():
    """Update file content."""
    data = request.get_json()
    path = safe_path(data.get('path', ''))
    content = data.get('content', '')

    if not path.exists():
        abort(404, 'File not found')

    if path.is_dir():
        abort(400, 'Cannot write to directory')

    try:
        path.write_text(content, encoding='utf-8')
        return jsonify({'success': True})
    except PermissionError:
        abort(403, 'Permission denied')


@app.route('/api/file', methods=['DELETE'])
def delete_files():
    """Delete file(s) or folder(s)."""
    data = request.get_json()
    paths = data.get('paths', [])

    if not paths:
        abort(400, 'No paths provided')

    deleted = []
    errors = []

    for p in paths:
        path = safe_path(p)
        if not path.exists():
            errors.append({'path': p, 'error': 'Not found'})
            continue

        try:
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink()
            deleted.append(p)
        except PermissionError:
            errors.append({'path': p, 'error': 'Permission denied'})

    return jsonify({'deleted': deleted, 'errors': errors})


@app.route('/api/move', methods=['POST'])
def move_files():
    """Move or rename file(s)/folder(s)."""
    data = request.get_json()
    items = data.get('items', [])  # List of {source, destination}

    if not items:
        abort(400, 'No items provided')

    moved = []
    errors = []

    for item in items:
        source = safe_path(item.get('source', ''))
        dest_path = item.get('destination', '').strip()

        if not dest_path or '..' in dest_path:
            errors.append({'source': item.get('source'), 'error': 'Invalid destination'})
            continue

        destination = safe_path(dest_path)

        if not source.exists():
            errors.append({'source': item.get('source'), 'error': 'Source not found'})
            continue

        if destination.exists():
            errors.append({'source': item.get('source'), 'error': 'Destination exists'})
            continue

        try:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(source), str(destination))
            moved.append({'source': item.get('source'), 'destination': dest_path})
        except PermissionError:
            errors.append({'source': item.get('source'), 'error': 'Permission denied'})

    return jsonify({'moved': moved, 'errors': errors})


@app.route('/api/upload', methods=['POST'])
def upload_files():
    """Upload file(s)."""
    parent = safe_path(request.form.get('path', ''))

    if not parent.is_dir():
        abort(400, 'Invalid upload directory')

    uploaded = []
    errors = []

    for file in request.files.getlist('files'):
        if not file.filename:
            continue

        # Sanitize filename
        filename = os.path.basename(file.filename)
        if not filename or '..' in filename:
            errors.append({'name': file.filename, 'error': 'Invalid filename'})
            continue

        dest = parent / filename

        try:
            file.save(str(dest))
            uploaded.append(str(dest.relative_to(ROOT_DIR)).replace('\\', '/'))
        except PermissionError:
            errors.append({'name': filename, 'error': 'Permission denied'})

    return jsonify({'uploaded': uploaded, 'errors': errors})


@app.route('/api/download')
def download_file():
    """Download a file."""
    path = safe_path(request.args.get('path', ''))

    if not path.exists():
        abort(404, 'File not found')

    if path.is_dir():
        abort(400, 'Cannot download directory')

    return send_file(path, as_attachment=True, download_name=path.name)


@app.route('/api/view')
def view_file_inline():
    """View a file inline (for PDF viewer, images, etc.)."""
    path = safe_path(request.args.get('path', ''))

    if not path.exists():
        abort(404, 'File not found')

    if path.is_dir():
        abort(400, 'Cannot view directory')

    return send_file(path, as_attachment=False)


def search_with_ripgrep(query: str, search_path: Path, max_results: int) -> list | None:
    """Search using ripgrep. Returns None if rg is not available."""
    try:
        # Run ripgrep with JSON output
        result = subprocess.run(
            [
                'rg', '--json', '-i', '-l',  # JSON output, case-insensitive, files only
                '--max-count', '3',           # Max 3 matches per file
                '--max-filesize', '1M',       # Skip files over 1MB
                '-g', '!.*',                  # Skip hidden files
                query, str(search_path)
            ],
            capture_output=True, text=True, timeout=30
        )
    except FileNotFoundError:
        return None  # ripgrep not installed
    except subprocess.TimeoutExpired:
        return None

    results = []
    file_matches = {}  # path -> list of matches

    for line in result.stdout.strip().split('\n'):
        if not line:
            continue
        try:
            data = json.loads(line)
            if data['type'] == 'match':
                file_path = data['data']['path']['text']
                line_num = data['data']['line_number']
                line_text = data['data']['lines']['text'].strip()[:200]

                if file_path not in file_matches:
                    file_matches[file_path] = []
                if len(file_matches[file_path]) < 3:
                    file_matches[file_path].append({
                        'line': line_num,
                        'text': line_text
                    })
        except (json.JSONDecodeError, KeyError):
            continue

    # Convert to result format
    for file_path, matches in file_matches.items():
        if len(results) >= max_results:
            break
        try:
            filepath = Path(file_path)
            rel_path = str(filepath.relative_to(ROOT_DIR)).replace('\\', '/')
            stat = filepath.stat()
            results.append({
                'name': filepath.name,
                'path': rel_path,
                'isDirectory': False,
                'size': stat.st_size,
                'modified': datetime.fromtimestamp(stat.st_mtime).isoformat(),
                'nameMatch': False,
                'contentMatches': matches
            })
        except (OSError, ValueError):
            continue

    return results


def search_with_python(query: str, search_path: Path, max_results: int) -> list:
    """Fallback Python-based search."""
    results = []
    query_lower = query.lower()
    max_file_size = 1024 * 1024

    binary_extensions = {'.pdf', '.jpg', '.jpeg', '.png', '.gif', '.bmp', '.ico', '.svg',
                         '.zip', '.tar', '.gz', '.rar', '.7z', '.exe', '.dll', '.so',
                         '.mp3', '.mp4', '.avi', '.mov', '.wav', '.flac', '.ogg',
                         '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.pyc'}

    try:
        for root, dirs, files in os.walk(search_path):
            dirs[:] = [d for d in dirs if not d.startswith('.')]

            for filename in files:
                if len(results) >= max_results:
                    break
                if filename.startswith('.'):
                    continue

                filepath = Path(root) / filename
                rel_path = str(filepath.relative_to(ROOT_DIR)).replace('\\', '/')
                name_match = query_lower in filename.lower()

                content_matches = []
                if not name_match:
                    ext = filepath.suffix.lower()
                    if ext not in binary_extensions:
                        try:
                            if filepath.stat().st_size <= max_file_size:
                                with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
                                    for line_num, line in enumerate(f, 1):
                                        if query_lower in line.lower():
                                            content_matches.append({
                                                'line': line_num,
                                                'text': line.strip()[:200]
                                            })
                                            if len(content_matches) >= 3:
                                                break
                        except (PermissionError, OSError):
                            pass

                if name_match or content_matches:
                    stat = filepath.stat()
                    results.append({
                        'name': filename,
                        'path': rel_path,
                        'isDirectory': False,
                        'size': stat.st_size,
                        'modified': datetime.fromtimestamp(stat.st_mtime).isoformat(),
                        'nameMatch': name_match,
                        'contentMatches': content_matches
                    })

            if len(results) >= max_results:
                break
    except PermissionError:
        pass

    return results


@app.route('/api/search')
def search_files():
    """Search for files by name and/or content."""
    query = request.args.get('q', '').strip()
    search_path = safe_path(request.args.get('path', ''))
    max_results = min(int(request.args.get('limit', 100)), 500)

    if not query:
        return jsonify({'results': []})

    if not search_path.is_dir():
        abort(400, 'Invalid search path')

    # Try ripgrep first, fall back to Python
    results = search_with_ripgrep(query, search_path, max_results)
    if results is None:
        results = search_with_python(query, search_path, max_results)

    # Also search directory names (always use Python for this)
    query_lower = query.lower()
    try:
        for root, dirs, _ in os.walk(search_path):
            if len(results) >= max_results:
                break
            for dirname in dirs:
                if dirname.startswith('.'):
                    continue
                if query_lower in dirname.lower():
                    dirpath = Path(root) / dirname
                    rel_path = str(dirpath.relative_to(ROOT_DIR)).replace('\\', '/')
                    stat = dirpath.stat()
                    results.append({
                        'name': dirname,
                        'path': rel_path,
                        'isDirectory': True,
                        'size': None,
                        'modified': datetime.fromtimestamp(stat.st_mtime).isoformat(),
                        'nameMatch': True,
                        'contentMatches': []
                    })
                    if len(results) >= max_results:
                        break
    except PermissionError:
        pass

    # Sort: directories first, then by name match, then alphabetically
    results.sort(key=lambda x: (not x['isDirectory'], not x['nameMatch'], x['name'].lower()))

    return jsonify({
        'query': query,
        'results': results[:max_results],
        'truncated': len(results) >= max_results
    })


@app.route('/api/folders')
def list_folders():
    """Get folder tree structure for move dialog."""
    exclude = request.args.getlist('exclude')  # Paths to exclude

    def get_folder_tree(path: Path, rel_prefix: str = '') -> list:
        folders = []
        try:
            for item in sorted(path.iterdir(), key=lambda x: x.name.lower()):
                if item.is_dir() and not item.name.startswith('.'):
                    rel_path = f"{rel_prefix}/{item.name}".lstrip('/')
                    # Skip excluded paths
                    if rel_path in exclude:
                        continue
                    folders.append({
                        'name': item.name,
                        'path': rel_path,
                        'children': get_folder_tree(item, rel_path)
                    })
        except PermissionError:
            pass
        return folders

    tree = get_folder_tree(ROOT_DIR)
    return jsonify({'folders': tree})


@app.route('/api/rename', methods=['POST'])
def rename_file():
    """Rename a file or folder."""
    data = request.get_json()
    path = safe_path(data.get('path', ''))
    new_name = data.get('newName', '').strip()

    if not new_name or '/' in new_name or '\\' in new_name or '..' in new_name:
        abort(400, 'Invalid name')

    if not path.exists():
        abort(404, 'Not found')

    new_path = path.parent / new_name

    if new_path.exists():
        abort(409, 'Name already exists')

    try:
        path.rename(new_path)
        return jsonify({'success': True, 'path': str(new_path.relative_to(ROOT_DIR)).replace('\\', '/')})
    except PermissionError:
        abort(403, 'Permission denied')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Filer - A simple file server')
    parser.add_argument('--root', '-r', default='.', help='Root directory to serve (default: current directory)')
    parser.add_argument('--port', '-p', type=int, default=5000, help='Port to run on (default: 5000)')
    parser.add_argument('--host', '-H', default='127.0.0.1', help='Host to bind to (default: 127.0.0.1)')
    args = parser.parse_args()

    ROOT_DIR = Path(args.root).resolve()

    if not ROOT_DIR.is_dir():
        print(f"Error: {ROOT_DIR} is not a valid directory")
        exit(1)

    # Initialize Quick Transfer
    qt_ensure_directories()
    cleanup_thread = threading.Thread(target=qt_cleanup_expired, daemon=True)
    cleanup_thread.start()

    # Store port in app config for Quick Transfer to access
    app.config['PORT'] = args.port

    print(f"Serving files from: {ROOT_DIR}")
    print(f"Server running at: http://{args.host}:{args.port}")
    print(f"Quick Transfer available at: http://{args.host}:{args.port}/qt/")

    app.run(host=args.host, port=args.port, debug=True)
